<?xml version="1.0" encoding="utf-8"?>
<!--
  管理员门（共享）：首次设密码 / 密码 + 可选 TOTP 解锁 / 设备屏幕锁快捷入口。

  两个宿主共用同一份 markup：
  - 原生管理页 `McpAdminActivity`（`activity_mcp_admin.xml`，隐藏回退）；
  - WebView 管理页 `McpWebAdminActivity`（`activity_mcp_web_admin.xml`，默认）。

  视图 ID 是**合约**：`McpAdminTest` / `McpWebAdminTest` 依赖它们，改名等于改行为。
  两段互斥（gateBox vs 宿主内容）由各自 Activity 控制可见性，本文件不写 visibility 逻辑。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gateBox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/gateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="解锁 MCP 管理"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:id="@+id/gateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="管理页可以发放静态 key、批准客户端、改策略与查看审计。先验证身份。"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/gatePasswordWrap"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="管理员密码"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/gatePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            android:inputType="textPassword"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/gatePassword2Wrap"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="再输一次（至少 8 位）"
        android:visibility="gone"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/gatePassword2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            android:inputType="textPassword"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/gateTotpWrap"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="动态码（6 位）"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/gateTotp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:saveEnabled="false"
            android:inputType="number"
            android:maxLength="7"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/gateError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/gateBusy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGateUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="40dp"
        android:text="解锁" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGateSetup"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="设置密码并进入"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGateDevice"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="用屏幕锁解锁"
        android:visibility="gone" />
</LinearLayout>
