# hc-health-mcp 环境（放在 NAS，600 权限；不要提交/不要贴聊天）
#
# 这个文件是模板。复制为部署目录的 .env（NAS 上是
# <deploy-dir>/.env）后填入真实值；
# 真实 .env、creds.json、任何 token/密码都不得提交到仓库。

HEALTH_DB=/data/health.db
HEALTH_CREDS=/data/creds.json
PORT=18927
FETCH_INTERVAL_SEC=900

# OAuth issuer / 资源地址。生产必须显式设置 https；不带尾部斜杠。
# 它同时决定 /.well-known 元数据里的 issuer/resource，绝不从请求 Host 拼装。
PUBLIC_BASE_URL=https://health.example.com

# 反向代理信任：只有 peer 命中 HCB_TRUSTED_PROXIES 时才信 nginx 的 X-Real-IP
# 与 Host/X-Forwarded-Proto 推导。容器经 compose 端口映射收到请求时，peer 是
# Docker 网关而不是 nginx，所以 NAS 部署通常需要 1。
#
# HCB_TRUSTED_PROXIES 必须是**真实的反代/Docker 网关单地址或最小 CIDR**；
# 不要写 172.16.0.0/12 这类整个 RFC1918 网段，否则同网段任何容器都能伪造 IP。
# 查真实网关：
#   docker network inspect hc-health-mcp_default \
#     --format '{{(index .IPAM.Config 0).Gateway}}'
# 若反代就在同一网络，填它的容器 IP/32；不确定时先留空（只信回环）并看日志。
HCB_TRUST_PROXY=1
HCB_TRUSTED_PROXIES=192.0.2.55/32,127.0.0.1/32

# 首次启动建管理员密码（至少 12 字符）。只在库里还没有 admin 哈希时生效；
# 建好后请从 .env 删除这一行，或改用：
#   docker exec -it hc-health-mcp python /app/hcb_admin.py bootstrap
# 不要把真实密码写进这个模板或提交。
HCB_ADMIN_PASSWORD=

# 会话与两步验证（秒 / 步）。
# 管理后台会话 4 小时；普通用户 12 小时；登录两步验证 preauth 5 分钟；
# HCB_TOTP_WINDOW=1 表示允许当前时间片前后各 1 个 30 秒步长（0 = 只认当前）。
# 这些值在进程启动时读取，改完需重启容器。
HCB_ADMIN_SESSION_TTL=14400
HCB_USER_SESSION_TTL=43200
HCB_PREAUTH_TTL=300
HCB_TOTP_WINDOW=1

# 审计保留天数（默认 90）。每小时清理一次，保留锚点后仍可校验链。
AUDIT_RETENTION_DAYS=90

# 只读展示用版本号；可留默认。
HCB_VERSION=2026.11.0

# 由部署者生成随机值。
# 旧的单 token（全端共用 legacy）；留空表示不用它，填真实随机值才启用。
# 不要保留 __TOKEN__ / CHANGE_ME 等模板字面量：server.py 启动时会拒绝。
HEALTH_MCP_TOKEN=
# 每个 agent 一把 token：名字:token[,名字:token...]；命中时名字进访问日志（agent=xxx）
# 例：HEALTH_MCP_TOKENS=pi-pc:xxxx,pi-phone:yyyy,cursor:zzzz
HEALTH_MCP_TOKENS=
